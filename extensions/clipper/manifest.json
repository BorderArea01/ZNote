{
  "manifest_version": 3,
  "name": "ZNote 媒体采集",
  "version": "0.9.15",
  "description": "悬停高清大图，S 下载、Z 保存知识库；视频嗅探支持 MP4 与 m3u8，保留作品标题、作者与来源。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "webRequest",
    "webNavigation",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "candidates.js",
        "image-candidates.js",
        "preview-layout.js",
        "preview-cache.js",
        "douyin-records.js",
        "douyin-metadata.js",
        "video-metadata.js",
        "video-groups.js",
        "video-thumbnails.js",
        "inline-gallery.js",
        "overlay.js",
        "connect.js",
        "vendor/article-extract.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.iesdouyin.com/*"
      ],
      "js": [
        "vendor/douyin-network.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 ZNote"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "打开 ZNote 采集工具"
    }
  },
  "options_page": "options.html",
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "batch.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
