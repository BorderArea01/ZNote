{
  "manifest_version": 3,
  "name": "ZNote 媒体采集",
  "version": "0.8.3",
  "description": "悬停高清大图，S 下载、Z 保存知识库；浮窗发现图片、MP4 与 m3u8，支持预览、下载和入库。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "webRequest",
    "webNavigation",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "candidates.js",
        "image-candidates.js",
        "preview-layout.js",
        "overlay.js",
        "connect.js",
        "vendor/article-extract.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 ZNote"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "打开 ZNote 采集工具"
    }
  },
  "options_page": "options.html",
  "key": ""
}
